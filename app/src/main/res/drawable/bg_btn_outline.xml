<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple">
    <!-- outline: fully transparent fill + hairline border, same radius/height
         as the primary filled button (Material3 outlined-button pairing) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/radius_lg" />
            <stroke android:width="1dp" android:color="@color/outline_variant" />
        </shape>
    </item>
</ripple>
